{
  "name": "claude-adapt-rules",
  "version": "0.1.9",
  "description": "Mines your Claude Code sessions for the corrections you had to repeat, then distils them into evidence-backed rules — per-repo automatically, global only with your approval.",
  "author": {
    "name": "Patrick Eisenschmidt"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "rules",
    "claude-md",
    "transcripts",
    "self-improvement",
    "memory",
    "python"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/inject.py"],
            "timeout": 15,
            "statusMessage": "claude-adapt-rules: loading this project's rules"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/capture.py"],
            "timeout": 20,
            "statusMessage": "claude-adapt-rules: capturing session"
          }
        ]
      }
    ]
  }
}
